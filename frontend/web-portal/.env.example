# Base URL of the deployed Django backend (its Lambda Function URL), no
# trailing slash. Set this in Cloudflare Pages' project environment
# variables too — and add this app's own deployed origin to the backend's
# FRONTEND_ORIGINS env var so CORS allows it. Auth here is a bearer token
# (src/api.js), not a cookie, so unlike frontend/portal this works fine
# pointed at a real backend even from plain-HTTP localhost — no dev proxy
# needed.
VITE_API_BASE_URL=https://uoby5fryqkhbasb7wicrtg5oiq0pgwth.lambda-url.eu-west-1.on.aws

# WhatsApp Embedded Signup (Deploy tab's "Connect your own WhatsApp
# number") — not secret, Meta's own JS SDK needs these client-side.
# App ID: App Dashboard's Basic settings. Config ID: App Dashboard →
# WhatsApp → Embedded Signup → create a configuration. Set both in
# Cloudflare Pages' project environment variables too.
VITE_WHATSAPP_APP_ID=
VITE_WHATSAPP_CONFIG_ID=
