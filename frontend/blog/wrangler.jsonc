{
  // Lets the blog deploy as a Worker with static assets (Workers Builds)
  // as well as a Pages project; either way it serves the Pelican output.
  "name": "vicinic-blog",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./output",
    "not_found_handling": "404-page"
  }
}
