# Neon Postgres connection string (found in the Neon dashboard)
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/dbname?sslmode=require
DJANGO_DB_SSL_REQUIRE=true

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to use local disk storage. In production this must be
# set (see template.yaml's TemplateAssetsBucket) — Lambda's filesystem is
# ephemeral and would otherwise lose every uploaded template's assets.
AWS_STORAGE_BUCKET_NAME=

# Defaults to the deployed Templify service; override only to point at a
# different conversion backend.
TEMPLIFY_FUNCTION_URL=https://dmt46thjvn6fyzwxfmpfwae7li0ccmyc.lambda-url.eu-west-1.on.aws/

# Used by the generic per-site contact form handler.
DEFAULT_FROM_EMAIL=
CONTACT_RECIPIENT_EMAIL=

# Comma-separated origins (scheme + host, no trailing slash) of the
# Cloudflare Pages frontend apps that call the JSON API (/api/...) —
# frontend/portal, and later web-portal/admin. e.g.
# https://vicinic-portal.pages.dev,https://portal.yourdomain.com
FRONTEND_ORIGINS=

# PayFast (builder/services/payfast.py) — recurring billing for a Site's
# paid package, which removes its "Powered by Vicinic" credit. Left unset,
# these default to PayFast's own published sandbox test-merchant
# credentials, which work out of the box for local dev and testing. Before
# taking real payments, set all three to your actual PayFast merchant
# account's details and set PAYFAST_SANDBOX=false.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
